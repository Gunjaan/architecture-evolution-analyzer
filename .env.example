# Optional Hugging Face explanation. Leave blank to run deterministic analysis only.
HF_TOKEN=
# Leave blank to use Hugging Face's current recommended chat model.
HF_MODEL=
# Defaults to Hugging Face's own provider instead of automatic third-party routing.
HF_PROVIDER=hf-inference
# Transient 429/5xx failures are retried with exponential backoff.
HF_MAX_RETRIES=2

# Application limits.
CEA_DEFAULT_SNAPSHOTS=15
CEA_MAX_SNAPSHOTS=60
CEA_MAX_WORKERS=2
